// server/tsconfig.json
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@/lib/*": ["../src/lib/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}